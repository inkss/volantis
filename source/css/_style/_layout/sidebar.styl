#l_side
  width: $sidebar
  float: right
  if hexo-config('sidebar.position') =='left'
    -webkit-box-ordinal-group: 1;
    -moz-box-ordinal-group: 1;
    -ms-flex-order: 1;
    -webkit-order: 1;
    order: 1;
  position: relative
  display: flex
  flex-direction: column
  @media screen and (max-width: $device-tablet)
    width: 100%
  .widget
    overflow: hidden
    &.sticky
      position: sticky
      top: $navbar-height + $gap
      z-index: 1
    >.content
      max-height: 200vh
      @media screen and (max-width: $device-tablet)
        max-height: none
      overflow: auto
      scrollbar()
      text-align: justify
      font-size: $fontsize-meta
      max-width: 100%


.widget
  z-index: 0
  background: var(--color-card)
  margin-bottom: $gap
  border-radius: $border-card
  width: 100%
  display: none
  ul,ol
    li
      margin-top: 0
      margin-bottom: 0
  &.desktop
    display: block
  @media screen and (max-width: $device-tablet)
    display: none !important
    &.mobile
      display: block !important


  header
    border-top-left-radius: $border-card
    border-top-right-radius: $border-card
    padding: "calc(%s - 2px)" % $gap
    font-size: $fontsize-meta
    padding-bottom: 0
    display: inline-flex;
    align-items: center;
    &,a
      color: var(--color-meta)
    >a:hover
      color: $color-hover
    a:has(svg.feather)
      display: contents;
    span:has(svg.feather)
      display: inline-flex
    span.name
      margin-left: $gap * 0.5


  >.content
    padding: $gap * 0.5 0
    p
      margin-top: $gap-p
      margin-bottom: $gap-p
      &:first-child
        margin-top: $gap-p * 0.5
    ul>li
      a
        color: var(--color-meta)
        padding: 0 $gap
        padding-left: $gap * 0.5 + 4px
        line-height: 2
        display: flex
        justify-content: space-between
        align-content: center
        border-left: $border-line solid transparent
        trans()
    ul.entry, ul.popular-posts
      list-style: none
      a
        color: var(--color-list)
        .name
          flex: auto
        .badge
          flex:none
          font-weight: normal
          font-size: $fontsize-meta
          color: alpha($color-text, .7)
        &.active
          border-left: 2px solid $color-theme
          list_active()
          .badge
            color: alpha($color-theme, .9)
        &.child
          padding-left: $gap * 2
        &:hover
          border-left: 2px solid $color-theme
          list_hover()



  &.blogger
    trans()
    .content
      padding: 0
      display: flex
      flex-direction: column
      align-items: stretch
      >.avatar
        align-self: center
        overflow: hidden
        position: relative
        border-top-left-radius: $border-card
        border-top-right-radius: $border-card
        line-height: 0
        &.circle
          border-radius: 100%
          width: 128px
          height: 128px
          margin-top: $gap * 2
          margin-bottom: $gap-p
          img
            display: block
            position: absolute
            top: 50%
            left: 50%
            transform: translate(-50%, -50%)
        @media screen and (max-width: $device-tablet)
          width: 80px
          height: 80px
          border-radius: 100%
          border: 2px solid white
          img
            display: block
            top: 50%
            left: 50%
            transform: translate(-50%, -50%)
            position: absolute
      .text
        :first-child
          margin-top: $gap
        margin-bottom 10px
      h2
        text-align: center
        font-weight: bold
        margin: $gap * 0.5
        @media screen and (max-width: $device-tablet)
          margin: $gap * 0.5
      p
        text-align: center
        font-weight: bold
        margin: $gap * 0.5 $gap * 0.5 0 $gap * 0.5
        empty-cells: hide
      .social-wrapper
        display: flex
        justify-content: space-between
        flex-wrap: wrap
        margin: 4px $gap * 0.25
        a
          color: var(--color-meta)
          padding: 0
          trans()
          &:hover
            color: $color-hover
          &.social
            display: flex
            justify-content: center
            align-items: center
            width: 32px
            height: 32px
            margin: 4px
            border-radius: 100px
            &:hover
              background: bgcolor($color-theme)
              color: $color-theme

        @media screen and (max-width: $device-tablet)
          justify-content: center
          display: none

    @media screen and (max-width: $device-tablet)
      box-shadow: none
      background: transparent !important
      margin-top: 2 * $gap
      backdrop-filter: none
      color: var(--color-site-inner)



  &.text
    .content
      &,p
        font-size: $fontsize-meta
        word-break: break-all
      padding: $gap * 0.25 $gap
      a
        color: $color-link
        trans()
        &:hover
          color: $color-hover
        &:active
          color: darken($color-hover, 25%)


  &.list
    .content
      padding: $gap * 0.5 0
      a
        font-size: $fontsize-meta
        font-weight: bold
        line-height: 1.5
        padding-top: 6px
        padding-bottom: 6px
        img,i
          margin-right: 4px
        i
          margin-left: 1px
        img
          vertical-align: middle
          height: 20px
          width: 20px
          margin-bottom: 4px
          &#round
            border-radius: 100%
        div.name
          font-weight initial


  &.grid
    .content
      .grid
        border: none
        display: flex
        flex-wrap: wrap
        justify-content: space-around
        padding: 0 $gap
        a
          text-align: center
          border-radius: $border-line
          margin: 2px
          padding: 8px 4px
          display: flex
          flex-direction: column
          align-items: center
          justify-content: center
          font-size: $fontsize-footnote
          font-weight: bold
          color: alpha($color-text, 70%)
          line-height: 1.5
          word-wrap: break-word
          i
            margin-top: .3em
            margin-bottom: .3em
            font-size: 1.8em
            width 24px
            height 24px

          img
            display: inline
            vertical-align: middle
            margin-bottom: 4px
            &#round
              border-radius: 100%

          &.active
            list_hover()
          &:hover
            list_hover()
            border-radius: $border-line


        &.fixed a
          width: calc(100%/3 - 4px)
          min-height 56px
          @media screen and (max-width: $device-tablet)
            width: calc(100%/6 - 4px)
          @media screen and (max-width: $device-mobile)
            width: calc(100%/5 - 4px)
          @media screen and (max-width: $device-mobile-l)
            width: calc(100%/4 - 4px)
          @media screen and (max-width: $device-mobile-m)
            width: calc(100%/3 - 4px)

  // 侧边栏 宫格布局 hover 颜色
  &.grid.navigation a
    color var(--color-list)
    &:hover
      color #ff5722
  .tab-pane-content a
    color var(--color-list)
    &:hover
      color #ff5722


  &.tagcloud
    .content
      text-align: justify
      padding: $gap * 0.5 $gap
      a
        display: inline-block
        trans()
        line-height: 1.2em
        margin: 4px 0
        border-bottom: 1px solid transparent
        &:hover
          color: $color-hover !important //to cover inline style.
          border-bottom: 1px solid $color-hover



  &.related_posts
    .content
      font-weight: bold
      ul
        margin-top: $gap * 0.5
        margin-bottom: $gap * 0.5
      h3
        font-size: $fontsize-meta
        font-weight: bold
        margin: 0
        a
          line-height: inherit
          padding-top: 4px
          padding-bottom: 4px



  &.qrcode
    .content
      display: flex
      flex-wrap: wrap
      align-items: center
      justify-content: space-around
      padding-left: $gap
      padding-right: $gap
      &,img
        margin-bottom: 4px


#l_side>.widget.page
  >.content
    padding-top: 0
    padding-left: $gap - 4px
    padding-right: $gap - 4px


// 插件 侧边栏 Tab 标签支持
.widget
  .tabs
    margin 0
    border none
    .nav-tabs
      border 1px solid rgba(68,68,68,0.2)
      border-radius 8px 8px 0 0
      li.tab
        flex 1
        &:last-child
          padding-right 0
    .tab-content
      font-size 14px
      p
        text-align center
        span
          font-weight bold
          padding 0 8px
      .tab-pane-content
        text-align center
        margin-top 0.5rem
    ul, p
      margin 0

// 插件 侧边栏 Next 导航
.nextsite
  font-size 0.875rem
  .site-brand-wrapper
    background rgba(0,0,0,0.8)
    box-shadow 0 2px 15px 0 rgb(0 0 0 / 60%)
    transition all 0.2s linear
    position relative
    @media screen and (min-width: $device-mobile)
      &:hover
        background rgba(0,0,0,0.9)
        border-radius 0 0 70px 70px
        box-shadow 0 8px 20px -3px rgb(0 0 0 / 60%)
    .site-meta
      text-align center
      font-size 1em
      line-height 2
      transition padding .2s ease-in-out
      padding 20px 0
      .brand
        display inline-block
      .site-title
        line-height 1.5
        color #f9a972
        font-size 1.8em
        text-shadow 0 1px 4px #fff
        margin 0.67em 0
        display inline-block
      .site-subtitle
        font-size .85rem
        color var(--color-meta)
    .site-nav-toggle
      left 20px
      top 50%
      transform translateY(-50%)
      display none
      position absolute
      @media screen and (max-width: $device-mobile)
        display block
      button
        margin-top 2px
        padding 9px 10px
        background transparent
        border none
        .btn-bar
          display block
          width 22px
          height 2px
          background #555
          border-radius 1px
          background-color #fff
        .btn-bar+.btn-bar
          margin-top 4px
  .site-nav
    @media screen and (max-width: $device-mobile)
      display none
      animation header-effect 0.3s cubic-bezier(0.68, -0.55, 0.27, 1.55)
    @media screen and (min-width: $device-mobile)
      display block !important
    margin 15px 0 10px 5px
    .next-main
      .menu-item-active a
        border-radius 50px 0 0 50px
        border-color transparent
        box-shadow 0 4px 20px -4px #00000040
        &:after
          content " "
          position absolute
          top 50%
          margin-top -3px
          right 15px
          width 6px
          height 6px
          border-radius 50%
          background-color #f9a972
      .next-main-item:hover a
        border-radius 50px 0 0 50px
        border-color transparent
        box-shadow 0 4px 20px -4px #00000040
        color #f9a972
      a
        display flex
        align-items center
        color var(--color-list)
        padding 5px 10px
        position relative
        .menu-item-icon
          margin-right 8px

// 插件 侧边栏 Next 身份介绍
.nextblogger
  padding 20px 10px 10px
  .site-author-image
    display block
    margin 0 auto
    padding 2px
    width 120px
    height 120px
    border 1px solid #eee
    opacity 1
    border-radius 100%
  .site-author-box
    margin-top 1rem
    text-align center
    .site-author-name
      font-weight 600
      font-size 1rem
      color var(--color-text)
      margin 0
    .site-author-description
      color var(--color-list)
      margin-top 2px
      font-size 0.85rem
  .links-of-author
    display flex
    flex-wrap wrap
    gap 4px
    justify-content center
    a
      color var(--color-list)
      &:hover
        color #f9a972
  .links-of-author-item
    margin 0 4px
    font-size 1.05rem
    color var(--text-color)

.webinfo
  padding 0.2rem 1rem
  .webinfo-item
    display block
    padding 4px 0 0
    div
      &:first-child
        display inline-block
      &:last-child
        display inline-block
        float right
    a
      color: var(--color-text) 
      &:hover
        color: #ff5722;

.widget-last
  display: block !important
  .item
    display: flex
    justify-content: space-between
    font-size: 0.8rem
  .item-title
    width: 100%  // 设定宽度
    display: inline-block  // 将 span 当作块级元素
    white-space: nowrap  // 不换行
    overflow: hidden  // 超出宽度部分隐藏
    text-overflow: ellipsis  // 超出部分以点号替代

.widget-sticky
  position: sticky
  top: $navbar-height + $gap
  z-index 10
