// 时间线组件样式（timenode + timelines-common 两套实现）
// ============================================
// 竖线节点式时间线（timeline / timenode 标签）
// ============================================

div.timenode
  position: relative
  &:before, &:after
    content: ''
    z-index: 1
    position: absolute
    background: alpha($color-theme, .5)
    width: 2px
    left: 7px
  &:before
    top: 0px
    height: 6px
  &:after
    top: 26px
    height: "calc(100% - %s)" % 26px
  &:last-child:after
    height: "calc(100% - 26px - %s)" % $gap
    border-bottom-left-radius: 2px
    border-bottom-right-radius: 2px
  .meta, .body
    max-width: "calc(100% - %s)" % (16px + 8px)
  .meta
    position: relative
    color: var(--color-meta)
    font-size: $fontsize-meta
    line-height: 32px
    height: 32px
    // 双层圆形标记（外圈 + 内圈）
    &:before, &:after
      content: ''
      position: absolute
      top: 8px
      z-index: 2
    &:before
      background: alpha($color-theme, .5)
      width: 16px
      height: 16px
      border-radius: 8px
    &:after
      background: $color-theme
      margin-left: 2px
      margin-top: 2px
      width: 12px
      height: 12px
      border-radius: 6px
      transform: scale(0.5)
      trans()
    p
      font-weight: bold
      margin: 0 0 0 16px + 8px
  .body
    margin: 4px 0 $gap 16px + 8px
    padding: $gap
    border-radius: $border-card
    background: var(--color-block)
    display: inline-block
    &:empty
      display: none
    >*
      &:first-child
        margin-top: $gap-p * 0.25
      &:last-child
        margin-bottom: $gap-p * 0.25
    .highlight
      border: 1px solid mix($color-block, $color-text, 90)

div.timenode:hover .meta
  color: var(--color-text)
  &:before
    background: alpha($color-hover, .5)
  &:after
    background: $color-hover
    transform: scale(1)


// ============================================
// 图标时间线（timelines / timenodes 标签，Feather SVG 图标）
// ============================================

.timelines-common
  background-color: var(--color-card)
  border-radius: 8px
  margin: -10px 0

  .elem-field
    border: 1px solid #e6e6e6
    margin-bottom: 10px
    padding: 0
    legend
      margin-left: 20px
      padding: 0 10px
      font-size: 20px
      font-weight: 300

  .field-title
    margin: 10px 0 20px
    border-width: 1px 0 0

  .timeline
    padding: 0 !important

    .timeline-item
      position: relative
      display: flex
      align-items: center
      list-style: none !important
      padding-bottom: 1rem
      // 左侧竖线（绝对定位，图标背景色遮盖）
      &:before
        content: ''
        position: absolute
        left: 7px
        top: 10px
        z-index: 0
        width: 2px
        height: 100%
        background-color: #e6e6e6
      &:last-child:before
        display: none

      // SVG 图标（flex 子项，中心 8px 对齐竖线）
      // 列宽：普通 16+14=30px，圆形 10+3+17=30px
      .timeline-axis
        flex-shrink: 0
        position: relative
        z-index: 10
        margin-right: 14px
        background-color: var(--color-card)
        color: var(--color-meta)
        &.feather.feather-circle
          width: 10px
          height: 10px
          margin-left: 3px
          margin-right: 17px

      .timeline-content
        flex: 1
        min-width: 0

        .timeline-title
          margin-bottom: 0

        &.timeline-content-text
          line-height: 20px
          font-size: 0.8rem
          color: #666
          p
            margin: 0

// 图标字体（独立工具类）
.timeline-icon
  font-family: timeline-icon !important
  font-size: 16px
  font-style: normal
  -webkit-font-smoothing: antialiased
  -moz-osx-font-smoothing: grayscale
