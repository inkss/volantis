// 标签页切换组件样式（tabs tag plugin）
$border-color = alpha($color-p, .2)
$tbr = 4px

// 标签页容器：圆角卡片 + 边框
div.tabs
  display: block
  position: relative
  margin-top: $gap-p
  margin-bottom: $gap-p
  border-radius: $tbr
  background: var(--color-card)
  border: 1px solid $border-color
  font-size: $fontsize-list
  .highlight,p,ul,ol,div.note,details
    margin-top: $gap-p
    margin-bottom: $gap-p

// 导航标签栏：水平滚动 + 激活态高亮
div.tabs
  ul.nav-tabs
    display: flex
    overflow-x: auto
    white-space: nowrap
    justify-content: flex-start
    margin: 0
    padding: 8px 8px 0 8px
    background: var(--color-block)
    border-radius: $tbr $tbr 0 0
    line-height: 1.5
    li.tab
      list-style-type: none
      margin-top: 0
      margin-bottom: 0
      &:last-child
        padding-right: $gap
      a
        display: flex
        align-items: center;
        cursor: $pointer
        border-radius: $tbr $tbr 0 0
        padding: $gap * 0.5
        text-align: center
        font-size: $fontsize-meta
        line-height: inherit
        font-weight: bold
        color: var(--color-meta)
        border: 1px solid transparent
        &:hover
          color: var(--color-p)
        i
          pointer-events: none
        svg.feather
         margin 0 auto
      &.active a
        cursor: $default
        color: var(--color-p)
        background: $color-card
        border: 1px solid $border-color
        border-bottom: 1px solid var(--color-card)
        transition 0.5s

  // 内容区域：激活面板显示 + 弹跳动画
  .tab-content
    border-top: 1px solid $border-color
    margin-top: -1px
    .tab-pane
      padding: $gap
      animation fade-in 0.3s
      &:not(.active)
        display: none
      &.active
        display: block
        animation tabshow 0.2s cubic-bezier(0.23, 0, 0, 1.32)
      >
        p,.tabs,ul,ol,.highlight,.note
          &:first-child
            margin-top: 0
          &:last-child
            margin-bottom: 0

// 标签页内嵌时间线时去除顶部间距
.tab-pane > .timeline > .h2
  padding-top 0
