// 异步加载的暗黑模式 强制覆盖样式

// 图片和图标亮度
fa-solid,
fa-regular,
fa-duotone,
fa-light,
fa-thin,
far,
fal,
fad,
fa,
svg.iconfont,
img,
.lazyload
  filter: brightness(convert(hexo-config('color_scheme.dark.brightness'))) !important

// 布局组件
.cus-article-bkg
  display none !important
a, .widget.text .content a
  color #abb2bf
  &:hover
    color #ff5722
.blur
  background unquote('color-mix(in srgb, var(--color-site-bg) 90%, transparent)') !important
.white-box.blur
  background unquote('color-mix(in srgb, var(--color-card) 90%, transparent)') !important
.nav-main .u-search-input
  background var(--color-card) !important
#l_main .article .prev-next > a
  background var(--color-card) !important
  &:hover
    background var(--color-site-bg) !important
.article blockquote
  background var(--color-card) !important
.references, .related_posts, .copyright blockquote, #l_body #s-top.show.hl
  background var(--color-block) !important
.article-title a
  color var(--color-h1) !important
hr.menuLoad-Content
  background var(--color-p)
details > summary
  color var(--color-p) !important
  background var(--color-site-bg) !important
details
  border 1px solid var(--color-site-bg) !important
  background var(--color-site-bg) !important

// 搜索弹窗
#u-search .modal,
#u-search .modal-header,
#u-search .modal-body
  background var(--color-card) !important
#u-search .modal-body .modal-results .result:hover
  background var(--color-block) !important
.u-search-input:hover
  background var(--color-block) !important
.u-search-input:focus
  background var(--color-site-body) !important
.l_header .m_search
  @media screen and (max-width: $device-mobile)
    background var(--color-site-bg) !important

// 搜索弹窗深色专用变量
#u-search
  --primary-color unquote('color-mix(in srgb, #4285f4 85%, #fff)')
  --border-color #383838
  --highlight-bg #3d2f08
  --highlight-color #f0b922
  --shadow-color rgba(0, 0, 0, 0.3)
  --text-secondary #2dc79e
  --bg-hover #1e1e1e

// 侧边栏和组件
.widget.blogger .content .social-wrapper a.social:hover
  background var(--color-card)
.widget >.content ul.entry a .badge, .widget >.content ul.popular-posts a .badge
  color unset !important
.content
  color var(--color-p)
.widget >.content a
  color var(--color-p) !important
  &:hover
    color var(--color-list-hl) !important
.note
  background var(--color-block) !important
div.tabs ul.nav-tabs li.tab.active a
  color var(--color-p)
  background var(--color-card)
kbd
  background var(--color-block) !important
.cover-wrapper.dock .menu .list-h a:hover, .cover-wrapper.featured .menu .list-h a:hover, .cover-wrapper.focus .menu .list-h a:hover
  color var(--color-text) !important

// 代码高亮
if hexo-config('plugins.code_highlight') == "highlightjs"
  .gutter
    background var(--color-card) !important
  .highlight figcaption
    background-color var(--color-codeblock)
  .highlight pre .line, .highlight pre .params
    color unquote('color-mix(in srgb, var(--color-text) 90%, transparent)')

// 表格
*:not(.highlight) >table tr
  background-color var(--color-card)
*:not(.highlight) >table th
  background var(--color-site-bg)
*:not(.highlight) table td, *:not(.highlight) table th
  border-color var(--color-site-bg)
*:not(.highlight) >table tr:hover
  background var(--color-codeblock)
.timenode .highlight
  border-color var(--color-site-bg) !important
blockquote p
  color var(--color-p)

// 标签
#archive-page .archive .all-tags ul li span
  color var(--color-text)
  background var(--color-block)

// 按钮
.btn-copy:hover
  background var(--color-site-body)

// OwO 表情
.OwO-items-image .OwO-item
  color #ccc !important
  &:hover
    background-color var(--color-block) !important

// 评论
.comment-policy
  background-color var(--color-card) !important

// 自定义注入文件
for $injects_dark in hexo-config('injects.dark')
  @import $injects_dark
