@import 'clipboard'
@import 'language'
@import 'color'

pre
  position relative

.hljs
  margin 0 - $gap
  padding $gap
  -webkit-font-smoothing auto
  -moz-osx-font-smoothing auto
  scrollbar()

.highlight
  position relative
  width 100%
  margin $gap-p 0
  display block
  background var(--color-block)
  font-size $fontsize-code
  font-family $fontfamily-code
  border-radius $border-codeblock
  line-height 1.5
  -webkit-font-smoothing auto
  -moz-osx-font-smoothing auto
  trans()
  if hexo-config('custom_css.body.highlight.grayscale') == true
    filter grayscale(100%)
  &:hover
    if hexo-config('custom_css.body.highlight.grayscale') == true
      filter grayscale(0%)
    figcaption
      trans()
      background darken($color-codeblock, 5%)
    .gutter
      background darken($color-codeblock, 5)
  figcaption
    font-size 0.815rem
    position sticky
    left 0
    padding $gap * 0.25 $gap * 0.5
    background darken($color-block, 5%)
    border-top-left-radius "calc(%s - 1px)" % $border-codeblock
    border-top-right-radius "calc(%s - 1px)" % $border-codeblock
  >table
    overflow auto
    display block
    scrollbar-codeblock()
    td, th
      padding 0
      border none
      line-height 1.5
    margin 0
    background-color transparent
    border none
    tr
      background-color transparent
      &:hover
        background-color transparent
    pre
      overflow-y hidden
    .gutter
      user-select none
      padding 0 12px
      text-align right
      border-width 0
      margin-left 0
      position sticky
      left 0
      z-index 1
      background darken($color-block, 5)
      pre
        color var(--color-meta)
    pre
      background transparent
      margin 0
      padding 0
      border none
      .code:before
        display none
    .code
      padding $gap * 1.25 $gap
      vertical-align top
      background-color transparent
      &:before
        content ""
        position absolute
        top 0
        right 0
        color var(--color-meta)
        font-size 0.815rem
        padding 4px 8px
