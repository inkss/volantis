//======================================//


//======================================//
// 页脚自定义响应式处理
.footerMax560
  @media screen and (max-width: 560px)
    display none

.footerMax490
  @media screen and (max-width: 490px)
    display none

.footerMax380
  @media screen and (max-width: 380px)
    display none
//======================================//


//======================================//
// 禁止选中
.not-select, figcaption, footer, section:not(.footnotes), details summary,
.new-meta-box, .prev-next, .atk-main-editor, .atk-list-header, .nav-tabs,
.copyright.license, .comment-policy, .commentTitle, .headimg-div
  user-select none
  & p, & span
    cursor $default
  &.default-cursor
    cursor $default !important
  & a span
    cursor $pointer !important
.allow-select
  user-select all
//======================================//


//======================================//
// 隐藏文本
.bb_spoiler, .bb_spoiler a, a .bb_spoiler, .bb_spoiler a.new
  cursor $pointer
  border-bottom 1px solid var(--color-p)
  background-color var(--color-card)
  color var(--color-card)
  text-shadow none
  padding 0 2px
  margin 0 2px
.bb_spoiler:hover, .bb_spoiler:active, .bb_spoiler:hover .bb_spoiler, .bb_spoiler:active .bb_spoiler
  color var(--color-p) !important
.bb_spoiler:hover
  opacity 1
  transition-duration 0.3s
//======================================//


//======================================//
// 文章页自定义背景
.cus-article-bkg
  @media screen and (max-width: $device-mobile)
    display none
  animation content-fadeIn-2s 2s ease-in-out
  background-size cover
  background-position center
  background-repeat no-repeat
  position fixed
  top 0
  bottom 0
  right 0
  left 0
  z-index -10
//======================================//


//======================================//
// 文章页导航栏修饰：剧中、加粗等
.fix-header-title
  margin 0 auto
  font-size 1.5rem
  overflow hidden
  font-weight 800 !important
  @media screen and (max-width: $device-mobile)
    margin unset !important
    font-size 1rem !important
//======================================//


//======================================//
// 自定义的淡入淡出
.content-in
  animation content-fadeIn 1s ease-in-out
@keyframes content-fadeIn
  0%
    opacity 0
    filter blur(10px)
    transform: scale(0.9)
  50%
    opacity 0
    filter blur(10px)
    transform: scale(0.95)
  100%
    opacity 1
    transform: scale(1)
    filter blur(0px)
    transform: scale(1)
@keyframes content-fadeIn-2s
  0%
    opacity 0
    filter blur(10px)
  50%
    opacity 0
    filter blur(10px)
  70%
    opacity 0
    filter blur(10px)
  100%
    opacity 1
    filter blur(0px)
//======================================//


//======================================//
// 插件 侧边栏 Tab 标签支持
.widget 
  .tabs
    margin 0
    border none
    .nav-tabs
      border 1px solid rgba(68,68,68,0.2)
      border-radius 8px 8px 0 0
      li.tab
        flex 1
        &:last-child
          padding-right 0
    .tab-content
      font-size 14px
      p
        text-align center
        span
          font-weight bold
          padding 0 8px
      .tab-pane-content
        text-align center
        margin-top 0.5rem
    ul, p
      margin 0


//======================================//
// 插件 侧边栏 Next 导航
.nextsite
  font-size 0.875rem
  .site-brand-wrapper
    background rgba(0,0,0,0.8)
    box-shadow 0 2px 15px 0 rgb(0 0 0 / 60%)
    transition all 0.2s linear
    position relative
    @media screen and (min-width: $device-mobile)
      &:hover
        background rgba(0,0,0,0.9)
        border-radius 0 0 70px 70px
        box-shadow 0 8px 20px -3px rgb(0 0 0 / 60%)
    .site-meta 
      text-align center
      font-size 1em
      line-height 2
      transition padding .2s ease-in-out
      padding 20px 0
      .brand
        display inline-block
      .site-title
        line-height 1.5
        color #f9a972
        font-size 1.8em
        text-shadow 0 1px 4px #fff
        margin 0.67em 0
        display inline-block
      .site-subtitle
        font-size .85rem
        color var(--color-meta)
    .site-nav-toggle
      left 20px
      top 50%
      transform translateY(-50%)
      display none
      position absolute
      @media screen and (max-width: $device-mobile)
        display block
      button
        margin-top 2px
        padding 9px 10px
        background transparent
        border none
        .btn-bar
          display block
          width 22px
          height 2px
          background #555
          border-radius 1px
          background-color #fff
        .btn-bar+.btn-bar
          margin-top 4px
  .site-nav
    @media screen and (max-width: $device-mobile)
      display none
      animation header-effect 0.3s cubic-bezier(0.68, -0.55, 0.27, 1.55)
    @media screen and (min-width: $device-mobile)
      display block !important
    margin 15px 0 10px 5px
    .next-main
      .menu-item-active a
        border-radius 50px 0 0 50px
        border-color transparent
        box-shadow 0 4px 20px -4px #00000040
        &:after
          content " "
          position absolute
          top 50%
          margin-top -3px
          right 15px
          width 6px
          height 6px
          border-radius 50%
          background-color #f9a972
      .next-main-item:hover a
        border-radius 50px 0 0 50px
        border-color transparent
        box-shadow 0 4px 20px -4px #00000040
        color #f9a972
      a
        display flex
        align-items center
        color var(--color-list)
        padding 5px 10px
        position relative
        .menu-item-icon
          margin-right 8px


//======================================//
// 插件 侧边栏 Next 身份介绍
.nextblogger
  padding 20px 10px 10px
  .site-author-image
    display block
    margin 0 auto
    padding 2px
    width 120px
    height 120px
    border 1px solid #eee
    opacity 1
    border-radius 100%
  .site-author-box
    margin-top 1rem
    text-align center
    .site-author-name
      font-weight 600
      font-size 1rem
      color var(--color-text)
      margin 0
    .site-author-description
      color var(--color-list)
      margin-top 2px
      font-size 0.85rem
  .links-of-author
    display flex
    flex-wrap wrap
    gap 4px
    justify-content center
    a
      color var(--color-list)
      &:hover
        color #f9a972
  .links-of-author-item
    margin 0 4px
    font-size 1.05rem
    color var(--text-color)


//======================================//
//HTTP 451 错误
.note.quote.cus451:after
  @media screen and (min-width: 900px)
    background: url("data:image/svg+xml;base64,")
    content " "
    height 160px
    right 5px
    top 5px
    width 160px
    position absolute
    background-size 160px
    background-repeat no-repeat


//======================================//
// 评论隐私
.comment-policy
  background-color #ebeef2
  position relative
  margin-bottom $gap-p
  background-position right 20px top 20px
  border-radius 4px
  .content
    padding 15px
    .comment-policy-title
      font-size 15px
      font-weight 600
      line-height 1.45em !important
    .comment-policy-link
      font-size 14px

