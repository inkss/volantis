<script>
function listenSidebarTOC() {
  const navItems = document.querySelectorAll(".toc li");
  if (!navItems.length) return;
  
  const targets = Array.from(navItems).map((element) => {
    const link = element.querySelector(".toc-link");
    const href = link.getAttribute("href");
    const targetId = href ? decodeURI(href).replace("#", "") : link.getAttribute("toc-action").split("toc-")[1]; // 兼容 hexo-blog-encrypt
    const target = document.getElementById(targetId);
    
    // 解除 a 标签 href 的 锚点定位
    if (href) {
      link.setAttribute("toc-action", `toc-${targetId}`);
      link.removeAttribute("href");
    }
    
    // 配置点击触发新的锚点定位
    if (target && target.id) {
      link.addEventListener("click", (event) => {
        event.preventDefault();
        volantis.scroll.to(target, { addTop: 80, observer: true });
        history.pushState(null, document.title, `#${target.id}`);
      });
    }
    
    return target;
  });

  function activateNavByIndex(target) {
    if (target.classList.contains("active-current")) return;

    document.querySelectorAll(".toc .active").forEach((element) => {
      element.classList.remove("active", "active-current");
    });

    target.classList.add("active", "active-current");
    let parent = target.parentNode;
    while (!parent.matches(".toc")) {
      if (parent.matches("li")) parent.classList.add("active");
      parent = parent.parentNode;
    }
  }

  volantis.activateNavIndex = 0;
  activateNavByIndex(navItems[volantis.activateNavIndex]);

  if (targets[0]) {
    volantis.scroll.push(() => {
      const topOffset = targets.map(target => target.getBoundingClientRect().top);
      if (topOffset[0] >= 0) {
        volantis.activateNavIndex = 0;
      } else if (topOffset[targets.length - 1] < 0) {
        volantis.activateNavIndex = targets.length - 1;
      } else {
        for (let index = 0; index < targets.length - 1; index++) {
          if (topOffset[index] < 0 && topOffset[index + 1] >= 0) {
            volantis.activateNavIndex = index;
            break;
          }
        }
      }
      activateNavByIndex(navItems[volantis.activateNavIndex]);
    });
  }
}

document.addEventListener("DOMContentLoaded", () => {
  volantis.requestAnimationFrame(listenSidebarTOC);
});
volantis.pjax.push(listenSidebarTOC);
</script>

