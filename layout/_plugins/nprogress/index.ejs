<%
  var nprogressConfig = theme.plugins.nprogress || {};
%>

<% if (nprogressConfig.enable) { %>
<link rel="stylesheet" href="<%- theme.plugins.nprogress.css %>">
<script type="text/javascript" src="<%- theme.plugins.nprogress.js %>"></script>
<script>
  volantis.pjax.push(()=> {
    NProgress?.done();
  });
  volantis.pjax.send(()=> {
    NProgress?.start();
  });
</script>
<% } %>
