<header itemscope itemtype="http://schema.org/WPHeader" id="l_header" class="l_header <%- theme.navbar.visiable %> <%- theme.custom_css.navbar.effect.join(' ') %>" >
  <div class='container'>
  <div id='wrapper'>
    <div class='nav-sub'>
      <p class="title fix-header-title"></p>
      <ul class='switcher nav-list-h m-phone' id="pjax-header-nav-list">
        <li><a id="s-comment" target="_self" title="comment">
          <i class="feather message-circle"></i>
        </a></li>
        <% if (page.sidebar == undefined || page.sidebar != false) { %>
          <li><a id="s-toc" target="_self" title="toc">
            <i class="feather list"></i>
          </a></li>
        <% } %>
      </ul>
    </div>
		<div class="nav-main">
      <% if (theme.navbar.logo) { %>
        <% let logo = theme.navbar.logo %>
        <a class="title flat-box" target="_self" href='<%- url_for("/") %>'>
          <% if (logo.img) { %>
            <img no-lazy class='logo' src='<%- logo.img %>'/>
          <% } %>
          <% if (logo.icon) { %>
            <i class='<%- logo.icon %>'></i>
          <% } %>
          <% if (logo.title) { %>
            <span><%- logo.title %></span>
          <% } %>
        </a>
      <% } %>
			<div class='menu navigation'>
				<ul class='nav-list-h m-pc'>
          <%
          let menu_list = theme.navbar.menu;
          %>
          <% function menu(value, type) { %>
            <% if (value.name == 'hr') { %>
              <hr>
            <% } else if (value.toggle == 'darkmode') { %>
              <li>
                <a class="menuitem flat-box header toggle-mode-btn">
                  <i class='<%= value.icon %> fa-fw'></i>
                  <span><%- value.name %></span>
                </a>
              <li>
            <% } else if (value.name != undefined && value.url  == undefined && value.rows == undefined) { %>
              <li class='header'>
                <% if (value.icon) { %><span class="icon"><i class='<%= value.icon %> fa-fw'></i></span><% } %>
                <span><%- value.name %></span>
              </li>
            <% } else { %>
              <li>
                <a class="menuitem flat-box faa-parent animated-hover"
                <%- value.url ? `href="` + url_for(value.url) + `" title="` + (value.description || value.name) + `"`
                        : ` title="` + (value.description || value.name) + `"` %>
                  <% if (value.rel) { %>
                    rel="<%- value.rel %>"
                  <% } %>
                  <% if (value.target) { %>
                    target="<%- value.target %>"
                  <% } %>
                  <% if (value.url) { %>
                    active-action="action-<%= url_for(value.url).replace(/\/|%|\./g, "")?url_for(value.url).replace(/\/|%|\./g, ""):"home" %>"
                  <% } %>>
                  <% if (value.icon) { %><span class="icon"><i class='<%= value.icon %> fa-fw'></i></span><% } %> <span><%- value.name %></span>
                </a>
                <% if (value.rows) { %>
                  <ul class="list-v">
                    <% value.rows.forEach(function(value){ %>
                      <% menu(value, type) %>
                    <%})%>
                  </ul>
                <% } %>
              </li>
            <% } %>
          <% } %>
          <% menu_list.forEach(function(value){ %>
            <% menu(value, 'pc') %>
          <% }) %>
				</ul>
			</div>
      <% if (theme.search.enable) { %>
      <div class="m_search">
        <form name="searchform" class="form u-search-form">
          <i class="icon feather search"></i>
          <input type="text" class="input u-search-input" placeholder="<%- theme.navbar && theme.navbar.search %>" />
        </form>
      </div>
      <% } %>

			<ul class='switcher nav-list-h m-phone'>
				<% if (theme.search.enable === true) { %>
					<li><a class="s-search feather search" target="_self" title="search"></a></li>
				<% } %>
				<li>
          <a target="_self" title="menu">
            <i class="icon feather layers"></i>
          </a>
          <ul class="menu-phone list-v navigation white-box">
            <% menu_list.forEach(function(value){ %>
              <% menu(value, 'mobile') %>
            <% }) %>
          </ul>
        </li>
			</ul>

      <!-- Custom Files header begin -->
      <%- volantis_inject('header') %>
      <!-- Custom Files header end -->
		</div>
	</div>
  </div>
</header>
