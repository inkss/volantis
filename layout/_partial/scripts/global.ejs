<script>
  // 暗黑模式
  <% if (theme.plugins.darkmode.enable) { %>
    let c = localStorage.getItem("color-scheme");
    c && document.documentElement.setAttribute("color-scheme", c);
  <% } %>


  // 按需加载的插件
  <% if (theme.plugins.globalJquery?.enable) { %>
    volantis.import = {
      jQuery: () => {
        if (typeof jQuery === 'undefined') {
          return volantis.js("<%- theme.plugins.globalJquery.js %>");
        } else {
          return Promise.resolve();
        }
      }
    };
  <% } %>

  // 全局配置
  volantis.GLOBAL_CONFIG = {
    root: '<%- config.root %>',
    scrollSmooth: <%- theme.scroll_smooth %>,
    default: <%- JSON.stringify(theme.default) %>,
    <% if(theme.sidebar.widget_library.webinfo.type.lastupd.enable){%>
    lastupdate: new Date(<%- theme.getStartTime %>),
    <% } %>
    cdn: {
      fancybox_css: '<%- theme.cdn.fancybox_css %>',
      fancybox_js: '<%- theme.cdn.fancybox_js %>'
    },
    sidebar: {
      for_page: <%- JSON.stringify(theme.sidebar.for_page) %>,
      for_post: <%- JSON.stringify(theme.sidebar.for_post) %>,
      webinfo: {
        lastupd: {
          enable: <%- JSON.stringify(theme.sidebar.widget_library.webinfo.type.lastupd.enable) %>,
          friendlyShow: <%- JSON.stringify(theme.sidebar.widget_library.webinfo.type.lastupd.friendlyShow) %>
        },
        runtime: {
          data: <%- JSON.stringify(theme.sidebar.widget_library.webinfo.type.runtime.data) %>,
          unit: <%- JSON.stringify(theme.sidebar.widget_library.webinfo.type.runtime.unit) %>
        }
      }
    },
    search: {
      <% if(theme.search.service === 'algolia') { %>
        appId: '<%- env.ALGOLIA_APP_ID || config.algolia.appId || config.algolia.applicationID %>',
        indexName: '<%- config.algolia.indexName %>',
        apiKey: '<%- env.ALGOLIA_API_KEY || config.algolia.apiKey %>',
        hitsPerPage: '<%- theme.search.algolia.hitsPerPage %>',
        placeholder: '<%- theme.search.algolia.placeholder %>',
        searchAsYouType: <%- theme.search.algolia.searchAsYouType %>
      <% } %>

      <% if(theme.search.service === 'hexo') { %>
        dataPath: (("<%- config.root %>" || "/").endsWith("/") ? "<%- config.root %>" || "/" : "<%- config.root %>/" || "/") + "<%- config?.jsonContent?.file || 'content.json' %>"
      <% } %>

      <% if(theme.search.service === 'meilisearch') { %>
        placeholder: '<%- theme.search.meilisearch.placeholder %>',
        apiKey: '<%- theme.search.meilisearch.searchKey %>',
        indexName: '<%- theme.search.meilisearch.indexName %>',
        appId: '<%- theme.search.meilisearch.hostUrl %>'
      <% } %>
    },
    languages: {
      <% if(theme.search.enable) { %>
        search: {
          hits_empty: "<%- __('search.hits_empty') %>",
          hits_stats: "<%- __('search.hits_stats') %>",
          normal: "<%- __('search.normal') %>",
          hits_found: "<%- __('search.hits_found') %>",
          history: "<%- __('search.history') %>",
          no_history: "<%- __('search.no_history') %>",
          clear_history: "<%- __('search.clear_history') %>",
          filter_all: "<%- __('search.filter_all') %>",
          filter_posts: "<%- __('search.filter_posts') %>",
          filter_pages: "<%- __('search.filter_pages') %>",
          filter_tags: "<%- __('search.filter_tags') %>",
          searching: "<%- __('search.searching') %>",
          placeholder: "<%- __('search.placeholder_search') %>",
          label_posts: "<%- __('search.label_posts') %>",
          label_pages: "<%- __('search.label_pages') %>",
          label_tags: "<%- __('search.label_tags') %>"
        },
      <% } %>
      post: {
        exit_readmode: "<%- __('post.exit_readmode') %>",
        print_tip: "<%- __('post.print_tip') %>"
      },
      plugins: {
        timeout: "<%- __('plugins.timeout') %>",
        load_fail: "<%- __('plugins.load_fail') %>"
      },
      clipboard: {
        copy_fail: "<%- __('clipboard.copy_fail') %>",
        no_support: "<%- __('clipboard.no_support') %>",
        img_target_missing: "<%- __('clipboard.img_target_missing') %>",
        img_link_missing: "<%- __('clipboard.img_link_missing') %>",
        clipboard_no_support: "<%- __('clipboard.clipboard_no_support') %>",
        clipboard_empty: "<%- __('clipboard.clipboard_empty') %>",
        clipboard_no_permission: "<%- __('clipboard.clipboard_no_permission') %>"
      },
      runtime: {
        days: "<%- __('runtime.days') %>"
      },
      time: {
        just_now: "<%- __('time.just_now') %>",
        seconds_ago: "<%- __('time.seconds_ago') %>",
        minutes_ago: "<%- __('time.minutes_ago') %>",
        hours_ago: "<%- __('time.hours_ago') %>",
        days_ago: "<%- __('time.days_ago') %>",
        date_format: "<%- __('time.date_format') %>"
      },
      search: {
        no_title: "<%- __('search.no_title') %>",
        config_invalid: "<%- __('search.config_invalid') %>"
      }
    }
  };
</script>